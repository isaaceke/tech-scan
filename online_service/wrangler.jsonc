{
  "name": "enugu-techlog-scanner",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "durable_objects": {"bindings": [{"name": "SCANNER", "class_name": "ScannerState"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ScannerState"]}],
  "rules": [{"type": "Text", "globs": ["**/*.html", "**/*.txt"], "fallthrough": true}],
